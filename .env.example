# MongoDB image
MONGO_IMAGE=mongo:9.0.4

# MongoDB port published on the host
MONGO_HOST_PORT=27017

# Application database
MONGODB_DB=feblog

# Administrator credentials — required for first initialization
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=please-change-this

# Read-only application credentials — created by the init script
MONGO_APP_USERNAME=feblog_reader
MONGO_APP_PASSWORD=please-change-this

# For builds running on the same host as MongoDB.
# Passwords used in a URI must be percent-encoded when necessary.
MONGODB_URI=mongodb://${MONGO_APP_USERNAME}:${MONGO_APP_PASSWORD}@127.0.0.1:${MONGO_HOST_PORT}/${MONGODB_DB}?authSource=${MONGODB_DB}